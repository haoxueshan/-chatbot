FROM python:3.12-slim
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PIP_NO_CACHE_DIR=1
WORKDIR /app
RUN apt-get update && apt-get install -y --no-install-recommends fonts-dejavu-core fonts-wqy-zenhei fonts-nanum fonts-ipafont-gothic fonts-noto-core curl && rm -rf /var/lib/apt/lists/*
COPY backend/requirements*.txt ./
RUN pip install -r requirements.txt -c requirements.lock.txt
RUN groupadd --gid 10001 classbridge && useradd --uid 10001 --gid classbridge --create-home classbridge && mkdir -p /data/files && chown -R classbridge:classbridge /app /data
COPY --chown=classbridge:classbridge backend/ /app/
USER classbridge
EXPOSE 8000
CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000", "--workers", "1", "--proxy-headers", "--forwarded-allow-ips", "*", "--no-access-log"]
