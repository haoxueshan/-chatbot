# Copy to .env. Never commit your .env or paste credentials into the browser.
# Local Windows development: SQLite + durable local outbox worker.
ENVIRONMENT=development
DATABASE_URL=sqlite:///./data/classbridge.db
TASK_MODE=local
REDIS_URL=redis://localhost:6379/0
DATA_DIR=./data
SECRET_KEY=replace-with-at-least-32-random-characters
COOKIE_SECURE=false
ALLOWED_ORIGINS=http://localhost,http://127.0.0.1,http://localhost:5173,http://127.0.0.1:5173,http://localhost:8000,http://127.0.0.1:8000,http://localhost:8080,http://127.0.0.1:8080
PUBLIC_BASE_URL=http://localhost:8000

# Compose: generate a random alphanumeric password (URL-safe).
POSTGRES_PASSWORD=replace-with-a-unique-random-alphanumeric-password
BIND_ADDRESS=127.0.0.1
HTTP_PORT=8080

# Production: COOKIE_SECURE=true, ALLOWED_ORIGINS=https://your-domain,
# PUBLIC_BASE_URL=https://your-domain. Only server processes can access these.
DASHSCOPE_API_KEY=
# Soniox realtime ASR only. Never put this value in the browser or a VITE_ variable.
SONIOX_API_KEY=
DASHSCOPE_WORKSPACE_ID=
DASHSCOPE_REGION=cn-beijing
ASR_MODEL=qwen-audio-3.1-asr-flash-streaming
FILETRANS_MODEL=qwen-audio-3.1-asr-flash-filetrans
TRANSLATION_MODEL=qwen-mt-flash
SUMMARY_MODEL=qwen3.7-flash
ANSWER_MODEL=qwen3.7-plus
EMBEDDING_MODEL=text-embedding-v4
RERANK_MODEL=qwen3-rerank
EMBEDDING_DIMENSIONS=1024
MODEL_TIMEOUT_SECONDS=30
# Application deadline for one upstream audio send; not an Aliyun model parameter.
ASR_SEND_TIMEOUT_SECONDS=5
# Bootstrap default only; existing profiles are managed in Settings. Aliyun and Soniox are implemented.
# MT/Embedding/RAG/file transcription still use DASHSCOPE_API_KEY independently.
ASR_PROVIDER=aliyun
# Optional positive seconds (max 300). Omit to inherit MODEL_TIMEOUT_SECONDS.
# Current-task events/heartbeats refresh inactivity; unrelated task events do not.
# ASR_EVENT_TIMEOUT_SECONDS=30
# Fixed finish-task drain deadline; heartbeats cannot extend it.
# ASR_FINISH_TIMEOUT_SECONDS=30

# Aliyun-only PCM batching. Browser capture remains mono PCM16LE, 16 kHz, 20 ms/frame.
# false restores one upstream message per browser frame; Soniox never uses this batcher.
ALIYUN_ASR_BATCH_ENABLED=true
ALIYUN_ASR_BATCH_MS=100
ALIYUN_ASR_BATCH_MAX_WAIT_MS=100
# Milliseconds of PCM (32 bytes/ms). Queue budget includes batches and in-flight sends.
AUDIO_QUEUE_WARNING_MS=1500
AUDIO_QUEUE_HIGH_WATER_MS=3000
AUDIO_QUEUE_MAX_MS=8000
BROWSER_AUDIO_BUFFER_WARNING_MS=1500
BROWSER_AUDIO_BUFFER_MAX_MS=8000
AUDIO_ARCHIVE_QUEUE_MAX_MS=8000
AUDIO_MAX_TOTAL_BUFFER_BYTES=4194304
AUDIO_PROCESS_MAX_BUFFER_BYTES=16777216
# Formal translations remain eligible. Defer indexing/summary for busy live sessions.
PROCESSING_BACKLOG_WARNING=100
PROCESSING_BACKLOG_DEGRADED=200
PROCESSING_BACKLOG_HARD_LIMIT=5000
ASR_DIAGNOSTICS_ENABLED=true
EVENT_LOOP_LAG_SAMPLE_MS=500
# Phase C is NOT implemented: startup rejects true. No automatic paid task/replay.
ASR_RECOVERY_ENABLED=false
ASR_RECOVERY_BUFFER_MS=30000
ASR_RECOVERY_MAX_ATTEMPTS=3
ASR_RECOVERY_MAX_DURATION_SECONDS=30
ASR_RECOVERY_BACKOFF_INITIAL_MS=1000
ASR_RECOVERY_BACKOFF_MAX_MS=4000
ASR_RECOVERY_AUTO_REPLAY_UNCERTAIN=false
# Optional test profile only: send=8, events=60, finish=60. Not a stability guarantee.
# AUDIO_MAX_QUEUE_FRAMES is deprecated; byte budgets and a 4096-node safety cap govern admission.

# Incremental previews enabled by default; restart API AND workers after changing.
# Existing .env values override defaults; update only explicitly approved parameters.
# Set false to use the legacy preview path; audio and ASR are unchanged.
INCREMENTAL_TRANSLATION_ENABLED=true
PREVIEW_MIN_STABLE_SECONDS=0.25
PREVIEW_INTERVAL_SECONDS=0.5
PREVIEW_MAX_WAIT_SECONDS=2.4
PREVIEW_MIN_WORDS=2
PREVIEW_MIN_CHANGE_CHARS=4
PREVIEW_MAX_CHARS=2048
PREVIEW_MAX_SENTENCES=64
PREVIEW_TTL_SECONDS=30
PREVIEW_CONCURRENCY=1
PREVIEW_CALLS_PER_MINUTE=40
PREVIEW_REUSE_TTL_SECONDS=15
TRANSLATION_POLL_SECONDS=0.1
TRANSLATION_EMIT_SECONDS=0.1

# Endpoint overrides are optional; see docs/MODEL_COMPATIBILITY.md.
# OPENAI_BASE_URL=https://{workspace-id}.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
# ASR_WS_URL=wss://{workspace-id}.cn-beijing.maas.aliyuncs.com/api-ws/v1/inference
# DASHSCOPE_BASE_URL=https://{workspace-id}.cn-beijing.maas.aliyuncs.com/api/v1

UPLOAD_MAX_MB=40
CAPTURE_MAX_SECONDS=6300
SUMMARY_INTERVAL_SECONDS=180
AUDIO_RETENTION_DAYS=7
STORAGE_BACKEND=local
S3_ENDPOINT_URL=
S3_BUCKET=
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Native Alibaba OSS (STORAGE_BACKEND=oss), private bucket only.
OSS_ENDPOINT=
OSS_BUCKET=
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
# Explicitly disable external tracing for private classroom data.
LANGCHAIN_TRACING_V2=false
LANGSMITH_TRACING=false
