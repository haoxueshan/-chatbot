# Copy to .env. Never commit your .env or paste credentials into the browser.
# Local Windows development: SQLite + durable local outbox worker.
ENVIRONMENT=development
DATABASE_URL=sqlite:///./data/classbridge.db
TASK_MODE=local
REDIS_URL=redis://localhost:6379/0
DATA_DIR=./data
SECRET_KEY=replace-with-at-least-32-random-characters
COOKIE_SECURE=false
ALLOWED_ORIGINS=http://localhost,http://127.0.0.1,http://localhost:5173,http://127.0.0.1:5173,http://localhost:8000,http://127.0.0.1:8000,http://localhost:8080,http://127.0.0.1:8080
PUBLIC_BASE_URL=http://localhost:8000

# Compose: generate a random alphanumeric password (URL-safe).
POSTGRES_PASSWORD=replace-with-a-unique-random-alphanumeric-password
BIND_ADDRESS=127.0.0.1
HTTP_PORT=8080

# Production: COOKIE_SECURE=true, ALLOWED_ORIGINS=https://your-domain,
# PUBLIC_BASE_URL=https://your-domain. Only server processes can access these.
DASHSCOPE_API_KEY=
DASHSCOPE_WORKSPACE_ID=
DASHSCOPE_REGION=cn-beijing
ASR_MODEL=qwen-audio-3.1-asr-flash-streaming
FILETRANS_MODEL=qwen-audio-3.1-asr-flash-filetrans
TRANSLATION_MODEL=qwen-mt-flash
SUMMARY_MODEL=qwen3.7-flash
ANSWER_MODEL=qwen3.7-plus
EMBEDDING_MODEL=text-embedding-v4
RERANK_MODEL=qwen3-rerank
EMBEDDING_DIMENSIONS=1024
MODEL_TIMEOUT_SECONDS=30
# Application deadline for one upstream audio send; not an Aliyun model parameter.
ASR_SEND_TIMEOUT_SECONDS=5

# Opt-in incremental text preview experiment; restart API AND workers after changing.
# Keep false until the private test session has passed; audio and ASR are unchanged.
INCREMENTAL_TRANSLATION_ENABLED=false
PREVIEW_MIN_STABLE_SECONDS=0.35
PREVIEW_INTERVAL_SECONDS=1.2
PREVIEW_MAX_WAIT_SECONDS=2.4
PREVIEW_MIN_WORDS=3
PREVIEW_MIN_CHANGE_CHARS=6
PREVIEW_MAX_CHARS=2048
PREVIEW_MAX_SENTENCES=64
PREVIEW_TTL_SECONDS=30
PREVIEW_CONCURRENCY=1
PREVIEW_CALLS_PER_MINUTE=20
PREVIEW_REUSE_TTL_SECONDS=15
TRANSLATION_POLL_SECONDS=0.1
TRANSLATION_EMIT_SECONDS=0.25

# Endpoint overrides are optional; see docs/MODEL_COMPATIBILITY.md.
# OPENAI_BASE_URL=https://{workspace-id}.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
# ASR_WS_URL=wss://{workspace-id}.cn-beijing.maas.aliyuncs.com/api-ws/v1/inference
# DASHSCOPE_BASE_URL=https://{workspace-id}.cn-beijing.maas.aliyuncs.com/api/v1

UPLOAD_MAX_MB=40
CAPTURE_MAX_SECONDS=6300
SUMMARY_INTERVAL_SECONDS=180
AUDIO_RETENTION_DAYS=7
STORAGE_BACKEND=local
S3_ENDPOINT_URL=
S3_BUCKET=
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Native Alibaba OSS (STORAGE_BACKEND=oss), private bucket only.
OSS_ENDPOINT=
OSS_BUCKET=
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
# Explicitly disable external tracing for private classroom data.
LANGCHAIN_TRACING_V2=false
LANGSMITH_TRACING=false
